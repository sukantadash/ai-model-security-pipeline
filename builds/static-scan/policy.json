{
  "version": 1,
  "immediate_fail": {
    "modelaudit_needles": [
      "exec",
      "eval",
      "os.system",
      "posix.system",
      "subprocess",
      "__reduce__",
      "pickle.loads"
    ],
    "tool_missing_needles": [
      "not installed",
      "not usable",
      "produced no sbom"
    ]
  },
  "timeouts": {
    "modelaudit_seconds": 1800,
    "fickling_seconds": 60,
    "modelscan_seconds": 600,
    "clamav_seconds": 900,
    "syft_seconds": 300,
    "grype_seconds": 300
  },
  "clamav": {
    "max_filesize": "100M",
    "max_scansize": "200M",
    "exclude_globs": ["*.safetensors", "*.gguf", "*.ggml", "*.onnx"]
  },
  "fickling_extensions": [".pkl", ".pickle", ".pt", ".pth", ".bin", ".joblib"],
  "fickling_max_files": 40,
  "fickling_max_bytes": 524288000,
  "magika_native_labels": ["elf", "pe", "macho", "dex", "java bytecode", "coff"],
