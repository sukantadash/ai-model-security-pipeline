# ODH S3 connection secret — same shape as Model Registry deploy (minio-system).
# script.sh Phase 15: sed PLACEHOLDER → MODEL_CONN_VERSION, creds from minio-s3-secret.yaml.
# Manual: cp this file, edit placeholders, oc apply -n model-test.
# publish-artifact recreates the secret per pipeline version on auto-pass/review.
apiVersion: v1
kind: Secret
metadata:
  name: redhatai-qwen3-8b-fp8-dynamic-PLACEHOLDER
  annotations:
    opendatahub.io/connection-type: s3
    opendatahub.io/connection-type-protocol: s3
    opendatahub.io/connection-type-ref: s3
    openshift.io/display-name: redhatai-qwen3-8b-fp8-dynamic-PLACEHOLDER
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: CHANGE_ME_MINIO_ROOT_USER
  AWS_SECRET_ACCESS_KEY: CHANGE_ME_MINIO_ROOT_PASSWORD
  AWS_DEFAULT_REGION: us-east-1
  AWS_S3_BUCKET: models-verified
  AWS_S3_ENDPOINT: http://minio.minio-system.svc:9000
