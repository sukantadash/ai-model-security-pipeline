# S3 credentials for zone namespaces — copy per namespace or use one secret with bucket-prefix rules.
#
#   oc create secret generic minio-s3 -n model-ingress \
#     --from-literal=MINIO_ENDPOINT=http://minio.minio-system.svc:9000 \
#     --from-literal=AWS_ACCESS_KEY_ID=<same-as-MINIO_ROOT_USER-or-scoped-user> \
#     --from-literal=AWS_SECRET_ACCESS_KEY=<password> \
#     --from-literal=AWS_REGION=us-east-1 \
#     --from-literal=AWS_ENDPOINT_URL=http://minio.minio-system.svc:9000 \
#     --from-literal=S3_USE_HTTPS=0
#
# Repeat for model-eval and model-test (test: read-only policy recommended for serving).
apiVersion: v1
kind: Secret
metadata:
  name: minio-s3
  annotations:
    # KServe storage-initializer reads these; AWS_ENDPOINT_URL in data is ignored.
    serving.kserve.io/s3-endpoint: minio.minio-system.svc:9000
    serving.kserve.io/s3-usehttps: "0"
    serving.kserve.io/s3-region: us-east-1
    serving.kserve.io/s3-verifyssl: "0"
    serving.kserve.io/s3-useanoncredential: "false"
    serving.kserve.io/s3-usevirtualbucket: "false"
type: Opaque
stringData:
  MINIO_ENDPOINT: http://minio.minio-system.svc:9000
  AWS_ACCESS_KEY_ID: minioadmin
  AWS_SECRET_ACCESS_KEY: CHANGE_ME_MINIO_ROOT_PASSWORD
  AWS_REGION: us-east-1
  # KServe storage initializer (LLMInferenceService) ignores MINIO_ENDPOINT.
  AWS_ENDPOINT_URL: http://minio.minio-system.svc:9000
  AWS_DEFAULT_REGION: us-east-1
  S3_USE_HTTPS: "0"
  S3_VERIFY_SSL: "0"
  AWS_S3_FORCE_PATH_STYLE: "true"
