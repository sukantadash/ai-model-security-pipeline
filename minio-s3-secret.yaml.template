# S3 credentials for zone namespaces — copy per namespace or use one secret with bucket-prefix rules.
#
#   oc create secret generic minio-s3 -n model-ingress \
#     --from-literal=MINIO_ENDPOINT=http://minio.minio-system.svc:9000 \
#     --from-literal=AWS_ACCESS_KEY_ID=<same-as-MINIO_ROOT_USER-or-scoped-user> \
#     --from-literal=AWS_SECRET_ACCESS_KEY=<password> \
#     --from-literal=AWS_REGION=us-east-1
#
# Repeat for model-eval and model-prod (prod: read-only policy recommended in production).
apiVersion: v1
kind: Secret
metadata:
  name: minio-s3
type: Opaque
stringData:
  MINIO_ENDPOINT: http://minio.minio-system.svc:9000
  AWS_ACCESS_KEY_ID: minioadmin
  AWS_SECRET_ACCESS_KEY: CHANGE_ME_MINIO_ROOT_PASSWORD
  AWS_REGION: us-east-1
